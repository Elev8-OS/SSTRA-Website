# ---------- Allgemein ----------
NODE_ENV=production
PORT=3000
# Öffentliche Adresse der Seite (ohne Slash am Ende)
BASE_URL=https://www.deine-domain.ch
# Zufälliger String, mind. 32 Zeichen:  openssl rand -hex 32
SESSION_SECRET=
# Erste Administratoren (Komma-getrennt). Diese können sich ohne GHL-Tag anmelden
# und danach im Vorstandsbereich weitere Rollen vergeben.
ADMIN_EMAILS=

# ---------- GoHighLevel (EIGENE Subaccount-Location für den Verband!) ----------
# Private Integration Token (Settings > Private Integrations)
GHL_TOKEN=
GHL_LOCATION_ID=
# Optional: Inbound-Webhook eines GHL-Workflows für Benachrichtigungen (Vorstand-Mail, Slack, Tasks)
GHL_WORKFLOW_WEBHOOK_URL=
# Falls GHL das Feld anders erwartet: field_value | fieldValue
GHL_FIELD_VALUE_KEY=field_value

# ---------- Stripe ----------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
